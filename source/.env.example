APP_NAME="mini-RAG"
APP_VERSION="0.1"

# ========================= Files =========================
FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
# Max upload size in MB
FILE_MAX_SIZE=10
# Read uploads in blocks of this many bytes
FILE_DEFAULT_CHUNK_SIZE=512000

# ======================== MongoDB ========================
# Use "mongomock://" to run fully in-memory without MongoDB (data is lost on restart)
MONGODB_URI="mongodb://localhost:27007"
MONGODB_DATABASE="mini-rag"

# ========================== LLM ==========================
# OPENAI -> OpenAI or any OpenAI-compatible server (Ollama, vLLM, LM Studio, ...)
# LOCAL  -> offline mode: hashing embeddings + extractive answers (no API key needed)
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"

OPENAI_API_KEY="sk-"
# Leave empty for api.openai.com, e.g. "http://localhost:11434/v1" for Ollama
OPENAI_API_URL=""

GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_SIZE=1536

INPUT_DEFAULT_MAX_CHARACTERS=4096
GENERATION_DEFAULT_MAX_TOKENS=512
GENERATION_DEFAULT_TEMPERATURE=0.1

# ======================= Vector DB =======================
VECTOR_DB_BACKEND="QDRANT"
# Folder (relative to source/assets/database) for the embedded Qdrant store
VECTOR_DB_PATH="qdrant_db"
# COSINE or DOT
VECTOR_DB_DISTANCE_METHOD="COSINE"
